{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ads.local/project-knowledge/defs.v1.schema.json",
  "$defs": {
    "semantic_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:\\u0000-\\u001f]+(?<!/)(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
    },
    "authority_class": {
      "enum": [
        "canonical",
        "candidate",
        "historical",
        "derived",
        "evidence",
        "capture"
      ]
    },
    "lifecycle_state": {
      "enum": [
        "ACTIVE",
        "PAUSED",
        "BLOCKED",
        "COMPLETED",
        "SUPERSEDED"
      ]
    },
    "scope": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "not": {
          "enum": [
            "action",
            "time",
            "at_time"
          ]
        }
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        ]
      }
    },
    "relation": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "REPLACE",
            "SUPPLEMENT",
            "SPECIALIZE",
            "CORRECT"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*(?![\\s\\S])"
        },
        "scope": {
          "type": "object",
          "propertyNames": {
            "minLength": 1,
            "not": {
              "enum": [
                "action",
                "time",
                "at_time"
              ]
            }
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            ]
          }
        }
      },
      "required": [
        "mode",
        "target"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "SPECIALIZE"
              }
            }
          },
          "then": {
            "required": [
              "scope"
            ],
            "properties": {
              "scope": {
                "minProperties": 1
              }
            }
          }
        }
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_revision": {
      "type": "object",
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:\\u0000-\\u001f]+(?<!/)(?![\\s\\S])"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
        },
        "hash_algorithm": {
          "const": "sha256"
        },
        "hash_basis": {
          "const": "GIT_BLOB_BYTES_AT_COMMIT"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "snapshot_mode": {
          "const": "COMMIT_SNAPSHOT"
        }
      },
      "required": [
        "source_path",
        "source_commit",
        "hash_algorithm",
        "hash_basis",
        "content_digest"
      ],
      "additionalProperties": false
    },
    "input_binding": {
      "type": "object",
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:\\u0000-\\u001f]+(?<!/)(?![\\s\\S])"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
        },
        "hash_algorithm": {
          "const": "sha256"
        },
        "hash_basis": {
          "const": "GIT_BLOB_BYTES_AT_COMMIT"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "snapshot_mode": {
          "const": "COMMIT_SNAPSHOT"
        },
        "semantic_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*(?![\\s\\S])"
        }
      },
      "required": [
        "source_path",
        "hash_algorithm",
        "hash_basis",
        "content_digest"
      ],
      "additionalProperties": false
    },
    "snapshot_mode": {
      "enum": [
        "COMMIT_SNAPSHOT",
        "WORKTREE_SNAPSHOT"
      ]
    },
    "constraint": {
      "type": "object",
      "properties": {
        "constraint_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*(?![\\s\\S])"
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "constraint_id",
        "requirement"
      ],
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "properties": {
        "generator_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*(?![\\s\\S])"
        },
        "generator_version": {
          "type": "string",
          "minLength": 1
        },
        "implementation_basis": {
          "const": "GIT_BLOB_BYTES_AT_COMMIT"
        },
        "implementation_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:\\u0000-\\u001f]+(?<!/)(?![\\s\\S])"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "implementation_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "generator_id",
        "generator_version",
        "implementation_basis",
        "implementation_files",
        "implementation_digest"
      ],
      "additionalProperties": false
    }
  }
}
