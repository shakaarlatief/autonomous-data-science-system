{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ads.local/project-knowledge/semantic_source.v1.schema.json",
  "title": "Project knowledge semantic_source V1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "profile": {
      "const": "semantic_source.v1"
    },
    "kind": {
      "$ref": "defs.v1.schema.json#/$defs/text"
    },
    "authority_class": {
      "$ref": "defs.v1.schema.json#/$defs/authority_class"
    },
    "semantic_id": {
      "$ref": "defs.v1.schema.json#/$defs/semantic_id"
    },
    "state": {
      "$ref": "defs.v1.schema.json#/$defs/lifecycle_state"
    },
    "scope": {
      "$ref": "defs.v1.schema.json#/$defs/scope"
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "defs.v1.schema.json#/$defs/relation"
      },
      "uniqueItems": true
    },
    "provenance": {
      "$ref": "defs.v1.schema.json#/$defs/references"
    },
    "references": {
      "$ref": "defs.v1.schema.json#/$defs/references"
    },
    "risk_or_reopen_triggers": {
      "$ref": "defs.v1.schema.json#/$defs/references"
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "effective_to": {
      "type": "string",
      "format": "date-time"
    },
    "authority_from": {
      "type": "string",
      "format": "date-time"
    },
    "authority_to": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "$ref": "defs.v1.schema.json#/$defs/semantic_id"
    }
  },
  "required": [
    "schema_version",
    "profile",
    "kind",
    "authority_class"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "EXPERIMENT_RESULT"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "outcome"
        ]
      },
      "else": {
        "not": {
          "required": [
            "outcome"
          ]
        }
      }
    }
  ]
}
