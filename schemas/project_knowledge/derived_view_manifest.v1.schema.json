{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ads.local/project-knowledge/derived_view_manifest.v1.schema.json",
  "title": "Project knowledge derived_view_manifest V1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "profile": {
      "const": "derived_view_manifest.v1"
    },
    "kind": {
      "$ref": "defs.v1.schema.json#/$defs/text"
    },
    "authority_class": {
      "const": "derived"
    },
    "semantic_id": {
      "$ref": "defs.v1.schema.json#/$defs/semantic_id"
    },
    "provenance": {
      "$ref": "defs.v1.schema.json#/$defs/references"
    },
    "references": {
      "$ref": "defs.v1.schema.json#/$defs/references"
    },
    "view_id": {
      "$ref": "defs.v1.schema.json#/$defs/semantic_id"
    },
    "view_path": {
      "$ref": "defs.v1.schema.json#/$defs/source_path"
    },
    "view_schema_version": {
      "$ref": "defs.v1.schema.json#/$defs/text"
    },
    "input_bindings": {
      "type": "array",
      "items": {
        "$ref": "defs.v1.schema.json#/$defs/input_binding"
      }
    },
    "generator": {
      "$ref": "defs.v1.schema.json#/$defs/generator"
    },
    "rebuildability_class": {
      "enum": [
        "DETERMINISTIC_BYTE_REBUILD",
        "DETERMINISTIC_SEMANTIC_REBUILD",
        "REGENERABLE_NONAUTHORITATIVE"
      ]
    },
    "created_or_refreshed_boundary": {
      "$ref": "defs.v1.schema.json#/$defs/text"
    },
    "freshness_basis": {
      "$ref": "defs.v1.schema.json#/$defs/text"
    },
    "snapshot_mode": {
      "$ref": "defs.v1.schema.json#/$defs/snapshot_mode"
    },
    "snapshot_status": {
      "enum": [
        "COMMITTED",
        "NON_COMMITTED"
      ]
    }
  },
  "required": [
    "schema_version",
    "profile",
    "kind",
    "authority_class",
    "view_id",
    "view_path",
    "view_schema_version",
    "input_bindings",
    "generator",
    "rebuildability_class",
    "created_or_refreshed_boundary",
    "freshness_basis",
    "snapshot_mode",
    "snapshot_status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "snapshot_mode": {
            "const": "WORKTREE_SNAPSHOT"
          }
        }
      },
      "then": {
        "properties": {
          "snapshot_status": {
            "const": "NON_COMMITTED"
          }
        }
      },
      "else": {
        "properties": {
          "snapshot_status": {
            "const": "COMMITTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "view_id": {
            "enum": [
              "source_catalog",
              "identity_index",
              "authority_index",
              "workstream_graph",
              "subject_index",
              "risk_obligation_index",
              "current_state_core",
              "current_state_core_markdown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "rebuildability_class": {
            "enum": [
              "DETERMINISTIC_BYTE_REBUILD",
              "DETERMINISTIC_SEMANTIC_REBUILD"
            ]
          }
        }
      }
    }
  ]
}
