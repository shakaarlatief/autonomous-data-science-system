{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ads.local/schemas/model_collaboration_thread_state_v1.schema.json",
  "title": "ADS Model Collaboration Thread State V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "thread_id",
    "review_mode",
    "lifecycle_state",
    "phase",
    "target",
    "task_owner",
    "target_write_owner",
    "participants",
    "allowed_secondary_write_surfaces",
    "next_expected_actor",
    "independence",
    "last_transition"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "thread_id": {"type": "string", "pattern": "^MC-[0-9]{4}$"},
    "review_mode": {
      "enum": ["SOLO", "REVIEWED", "INDEPENDENT_THEN_COMPARATIVE", "COORDINATED_HANDOFF", "ADVERSARIAL_REVIEW"]
    },
    "lifecycle_state": {
      "enum": ["OPEN", "ACTIVE", "WAITING", "RESOLVED", "UNRESOLVED", "DEFERRED", "CLOSED"]
    },
    "phase": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z0-9][A-Z0-9_-]*$"},
    "target": {"$ref": "#/$defs/target"},
    "task_owner": {"type": "string", "minLength": 1},
    "target_write_owner": {"type": ["string", "null"], "minLength": 1},
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/participant"}
    },
    "allowed_secondary_write_surfaces": {
      "type": "array",
      "items": {"$ref": "#/$defs/writeSurface"}
    },
    "next_expected_actor": {"type": ["string", "null"], "minLength": 1},
    "independence": {"$ref": "#/$defs/independence"},
    "last_transition": {"$ref": "#/$defs/transition"}
  },
  "$defs": {
    "repoPath": {"type": "string", "minLength": 1, "maxLength": 512},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "base_ref", "description", "write_paths"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "base_ref": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "write_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repoPath"}
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collaborator_id", "interaction_environment", "interaction_session", "roles"],
      "properties": {
        "collaborator_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "interaction_environment": {"type": "string", "minLength": 1},
        "interaction_session": {"type": "string", "minLength": 1},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["TASK_OWNER", "INDEPENDENT_REVIEWER", "REVIEWER", "CRITIC", "COUNTER_DESIGNER", "RESEARCHER", "IMPLEMENTER", "VERIFIER", "HUMAN_DECIDER"]
          }
        }
      }
    },
    "writeSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collaborator_id", "paths"],
      "properties": {
        "collaborator_id": {"type": "string", "minLength": 1},
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repoPath"}
        }
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "review_base_ref", "known_exposures", "notes"],
      "properties": {
        "status": {"enum": ["NOT_APPLICABLE", "BLIND_TO_CANDIDATE", "PARTIALLY_INDEPENDENT", "COMPARATIVE_ONLY"]},
        "review_base_ref": {"type": ["string", "null"]},
        "known_exposures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "notes": {"type": ["string", "null"]}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_id", "from_state", "to_state", "actor", "reason", "repository_head"],
      "properties": {
        "transition_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
        "from_state": {"anyOf": [{"enum": ["OPEN", "ACTIVE", "WAITING", "RESOLVED", "UNRESOLVED", "DEFERRED", "CLOSED"]}, {"type": "null"}]},
        "to_state": {"enum": ["OPEN", "ACTIVE", "WAITING", "RESOLVED", "UNRESOLVED", "DEFERRED", "CLOSED"]},
        "actor": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "repository_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    }
  }
}
