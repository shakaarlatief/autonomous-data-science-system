{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ads-probe-v02:receipt:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "event_type",
    "source_revision",
    "payload"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "public_classification": {
          "type": "string"
        }
      }
    }
  }
}
