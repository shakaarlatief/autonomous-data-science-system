{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "probe_id",
    "detector",
    "annotations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "probe_id": {
      "const": "OPERATIVE-SP4-V01"
    },
    "detector": {
      "type": "string",
      "minLength": 1
    },
    "annotations": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "label",
          "confidence",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^S[0-9]{3}$"
          },
          "label": {
            "enum": [
              "LEAK",
              "NO_LEAK"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}
