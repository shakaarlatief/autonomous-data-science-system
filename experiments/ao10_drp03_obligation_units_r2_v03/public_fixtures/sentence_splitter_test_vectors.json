        "Next sentence starts here."
      ]
    },
    {
      "id": "decimal",
      "input": "The threshold is 0.90. It remains frozen.",
      "expected": [
        "The threshold is 0.90.",
        "It remains frozen."
      ]
    },
    {
      "id": "section",
      "input": "See \u00a7 3.2 for context. The rule remains active.",
      "expected": [
        "See \u00a7 3.2 for context.",
        "The rule remains active."
      ]
    },
    {
      "id": "eg",
      "input": "Use exact evidence, e.g. a test receipt. Do not infer it.",
      "expected": [
        "Use exact evidence, e.g. a test receipt.",
        "Do not infer it."
      ]
    },
    {
      "id": "ie",
      "input": "The state is derived, i.e. it is not authored. Review follows.",
